{
    "target": "esp32s3",
    "builds": [
        {
            "name": "echoear",
             "sdkconfig_append": [
                 "CONFIG_USE_EMOTE_MESSAGE_STYLE=y",
                 "CONFIG_MMAP_FILE_NAME_LENGTH=32",
                 "CONFIG_LANGUAGE_EN_US=y",
                 "CONFIG_FLASH_EXPRESSION_ASSETS=y",
                 "CONFIG_USE_DEVICE_AEC=y",
                 "CONFIG_USE_HOTSPOT_WIFI_PROVISIONING=n",
                 "CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=y",
                 "CONFIG_USE_SD_CARD=y",
                 "CONFIG_SD_CARD_MODE_SDMMC=y",
                 "CONFIG_FATFS_LFN_HEAP=y",
                 "CONFIG_SR_MN_EN_MULTINET6_QUANT=y",
                 "CONFIG_SPIRAM=y",
                 "CONFIG_SPIRAM_MODE_OCT=y",
                 "CONFIG_SPIRAM_SPEED_80M=y"
             ]
        }
    ]
}
